<mxfile host="app.diagrams.net"><diagram id="onward-photos" name="onward-dev delivery photos"><mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Onward Logistics: delivery photos (onward-dev)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5b6779'&gt;Riders upload proof-of-delivery photos; customers and merchants view them through CloudFront. Photos in a private, versioned S3 bucket replicated to eu-central-1; details in RDS PostgreSQL Multi-AZ; Django on ECS Fargate. Infrastructure by CloudFormation Git sync, releases blue/green by CodePipeline → CodeDeploy.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="560" height="110" as="geometry"/></mxCell><mxCell id="users" value="Riders, merchants&lt;br&gt;and customers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#232F3E;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="ghinfra" value="&lt;b&gt;AWS-Onward-Delivery-Photos-Storage-Infra&lt;/b&gt;&lt;br&gt;CloudFormation templates + deployment files&lt;br&gt;CI: cfn-lint, standards, publish nested templates" style="dashed=0;outlineConnect=0;html=1;shape=mxgraph.weblogos.github;fontColor=#232F3E;fontSize=12;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1430" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="ghapp" value="&lt;b&gt;AWS-